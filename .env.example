PORT=3000
DATABASE_PATH=./data/nextme.sqlite
APP_ORIGIN=http://localhost:3000
# For deployment set NODE_ENV=production and APP_ORIGIN=https://your-domain

# Choose openai or openrouter. Keep keys server-side; never use VITE_* secrets.
AI_PROVIDER=openai
AI_API_KEY=
# Blank values use the selected provider's documented defaults.
AI_BASE_URL=
AI_MODEL=
# Optional separate image provider/key. Blank means use the text provider.
AI_IMAGE_PROVIDER=
AI_IMAGE_API_KEY=
AI_IMAGE_BASE_URL=
AI_IMAGE_MODEL=

# Optional: a real https:// contact URL or mailto: address for browser push.
# Uses APP_ORIGIN on HTTPS by default. Browser VAPID keys persist in SQLite.
VAPID_SUBJECT=
# Optional developer contact for Open Library request identification.
API_CONTACT_EMAIL=
